# Copy to /etc/nginx/sites-available/api.waseetai.com
# Replace api.waseetai.com if you choose a different API subdomain.

upstream waseetai_backend {
    server 127.0.0.1:5010;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name api.waseetai.com;

    client_max_body_size 15M;

    location / {
        proxy_pass http://waseetai_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required by Socket.IO/WebSocket endpoints.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /health {
        proxy_pass http://waseetai_backend/health;
        proxy_set_header Host $host;
        access_log off;
    }
}

# After issuing the certificate, Certbot will normally add the HTTPS server
# block and redirect HTTP to HTTPS. Keep the same proxy location in that block.
