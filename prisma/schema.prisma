  createdAt  DateTime             @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// One row per user, shared across every role/dashboard (client, provider,
// marketer/affiliate). `settings` is a flat string→boolean map so each
// role's page can read/write only the keys it cares about (e.g. client's
// "newOffer"/"walletActivity", provider's "orders_offers_new"/"finance_wallet",
// marketer's "marketer_new_referral") without needing a separate model or
// migration per role. A PATCH merges into the existing object rather than
// replacing it, so one role's save can never wipe out another role's keys
// on a multi-role account.
model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}

// A support ticket raised by a client or provider (role-agnostic — same
// model for both, scoped by userId, following the same "own disputes"
// pattern as Dispute.openedById). description holds the original complaint;
// SupportTicketMessage holds the reply thread, seeded with that same text
// as the first message so the detail page's thread always starts somewhere.
model SupportTicket {
  id             String              @id @default(uuid())
  ticketNumber   String              @unique
  userId         String
  user           User                @relation("SupportTicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  subject        String
  category       String
  priority       String              @default("عادية")
  description    String              @db.Text
  relatedOrder   String?
  relatedProject String?
  relatedMember  String?
  ccEmail        String?
  status         SupportTicketStatus @default(OPEN)
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  messages SupportTicketMessage[]

  @@index([userId, status])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation("SupportTicketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String        @db.Text
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  FILE
  SYSTEM
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id         String  @id @default(uuid())
  projectId  String  @map("project_id")
  offerId    String? @map("offer_id")
  clientId   String  @map("client_id")
  providerId String  @map("provider_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   User      @relation("ClientConversations", fields: [clientId], references: [id])
  provider User      @relation("ProviderConversations", fields: [providerId], references: [id])
  messages Message[]

  @@unique([projectId, providerId])
  @@map("conversations")
}

model Message {
  id             String @id @default(uuid())
  conversationId String @map("conversation_id")
  senderId       String @map("sender_id")

  type    MessageType   @default(TEXT)
  content String?       @db.Text
  status  MessageStatus @default(SENT)

  // Attachments metadata (Images, Audio, Docs)
  fileUrl       String? @map("file_url")
  fileName      String? @map("file_name")
  fileSize      Int?    @map("file_size")
  audioDuration Int?    @map("audio_duration")

  // Discussion context (project/stage/delivery reference, like WhatsApp reply preview)
  context Json?

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

