// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  // partialIndexes: required for PayoutAttempt's active_attempt_unique
  // constraint below (a genuine PostgreSQL partial unique index — "at most
  // one PENDING/PROCESSING PayoutAttempt per Withdrawal" — enforced by
  // Postgres itself, not application logic). Confirmed empirically against
  // this exact installed Prisma 7.8.0 (both a minimal model and this whole
  // schema) before adding it here: `prisma validate` accepts it, and a
  // `prisma migrate diff` between this schema with/without the flag alone
  // (no partial index used) renders an EMPTY migration — enabling the flag
  // has zero effect on anything else in this schema. Prisma/prisma,
  // @prisma/client and @prisma/adapter-pg are pinned to the exact resolved
  // 7.8.0 (not a caret range) specifically because this is a preview
  // feature — its shape is not covered by Prisma's stable-API semver
  // guarantee, so an unpinned minor/patch bump could silently change how
  // this syntax parses or what SQL it renders.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

//account type
enum AccountType {
  CLIENT_COMPANY
  CLIENT_INDIVIDUAL
  PROVIDER_COMPANY
  PROVIDER_INDIVIDUAL
  MARKETING_BROKER
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

// KYC and Moderation for account status
enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  SUSPENDED_REVIEW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  CLIENT
  PROVIDER
  AFFILIATE
  ADMIN
  SUPER_ADMIN
}

// user proffile
model User {
  id          String      @id @default(uuid())
  accountType AccountType
  status      UserStatus  @default(PENDING_VERIFICATION)

  roles      UserRole[] @default([CLIENT])
  activeRole UserRole   @default(CLIENT)
  isBanned   Boolean    @default(false)

  firstName        String
  lastName         String
  email            String  @unique
  phoneCountryCode String? @default("+966")
  phoneNumber      String? @unique
  // Gates the mandatory phone OTP challenge on login (see auth.service.ts
  // loginUser/googleAuth). Defaults to false so existing accounts are
  // unaffected; set true explicitly for every account created going forward.
  phoneOtpEnabled  Boolean @default(false)
  password         String?
  avatarUrl        String?

  authProvider String  @default("local") // "local" or "google"
  googleId     String? @unique

  agreedToTerms Boolean @default(false)

  // Profile & Levels Tracking
  profileCompletionPercent Int    @default(0)
  currentLevel             String @default("مستكشف - المستوى 1")
  pointsToNextLevel        Int    @default(100)
  currentPoints            Int    @default(0)

  // Identity (بيانات الهوية)
  idNumber               String?
  idExpiryDate           DateTime?
  idDocumentUrl          String?
  commercialRegistration String?
  vatCertificateUrl      String?

  // Contact (بيانات التواصل)
  alternativePhone String?
  address          String?
  city             String?
  region           String?

  // Banking (البيانات البنكية)
  ibanNumber        String?
  bankName          String?
  accountHolderName String?

  // Real-time tracking & Financial Metrics
  lastActiveAt           DateTime? @default(now())
  walletBalance          Decimal   @default(0.00) @db.Decimal(12, 2)
  totalGmvAmount         Decimal   @default(0.00) @db.Decimal(12, 2)
  completedProjectsCount Int       @default(0)
  ratingAverage          Float?    @default(0.0)
  tierLevel              String?   @default("Bronze") // Bronze, Silver, Gold

  // AI Fraud & Risk System
  aiRiskScore       Int       @default(10) // 0 to 100
  aiRiskLevel       RiskLevel @default(LOW) // LOW, MEDIUM, HIGH
  aiSuspiciousNotes String?   @db.Text

  // Phase 7 — company-wide monthly cap (SAR) on total marketing discounts
  // (coupons + special offers), set by the PROVIDER_COMPANY account owner.
  // null = no cap configured. Only meaningful for PROVIDER_COMPANY users.
  marketingMonthlySpendCap Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otps             OtpVerification[]
  clientProfile    ClientProfile?
  providerProfile  ProviderProfile?
  affiliateProfile AffiliateProfile?
  referredBy       Referral?         @relation("ReferredUser")

  clientProjects   Project[]         @relation("ClientProjects")
  providerProjects Project[]         @relation("ProviderProjects")
  savedProjects    SavedProject[]    @relation("ProviderSavedProjects")
  proposals        Proposal[]
  projectProposals ProjectProposal[]

  modificationRequests ProfileModificationRequest[]

  providerServices        ServiceCatalog[]         @relation("ProviderServices")
  couponsCreated          Coupon[]                 @relation("ProviderCoupons")
  couponRedemptions       CouponRedemption[]
  specialOffersCreated    SpecialOffer[]           @relation("ProviderSpecialOffers")
  specialOfferRedemptions SpecialOfferRedemption[]
  marketplaceFavorites    MarketplaceFavorite[]
  reviewsWritten          Review[]                 @relation("ReviewClient")
  reviewsReceived         Review[]                 @relation("ReviewProvider")
  gamification            ProviderGamification?
  pointTransactions       PointTransaction[]
  walletTransactions      WalletTransaction[]
  paypalPayments          PaypalPayment[]
  accountAuditLogs        AccountAuditLog[]
  notifications           Notification[]
  sessions                UserSession[]
  clientConversations     Conversation[]           @relation("ClientConversations")
  providerConversations   Conversation[]           @relation("ProviderConversations")
  sentMessages            Message[]

  cart                Cart?
  orders              Order[]
  onboarding          ClientOnboarding?
  disputesOpened      Dispute[]         @relation("DisputesOpenedBy")
  disputesAgainst     Dispute[]         @relation("DisputesAgainstUser")
  disputesResolved    Dispute[]         @relation("DisputesResolvedBy")
  withdrawals         Withdrawal[]      @relation("WithdrawalUser")
  reviewedWithdrawals Withdrawal[]      @relation("WithdrawalReviewer")

  clientContracts   Contract[] @relation("ClientContracts")
  providerContracts Contract[] @relation("ProviderContracts")

  clientProjectAmendments    ProjectAmendment[] @relation("ClientProjectAmendments")
  providerProjectAmendments  ProjectAmendment[] @relation("ProviderProjectAmendments")
  requestedProjectAmendments ProjectAmendment[] @relation("RequestedProjectAmendments")

  // Company team members (Phase 4) — records owned/managed by a
  // PROVIDER_COMPANY account; team members have no login of their own.
  companyTeamMembers CompanyTeamMember[] @relation("CompanyTeamMembers")

  notificationPreference NotificationPreference?

  supportTickets        SupportTicket[]        @relation("SupportTicketOwner")
  supportTicketMessages SupportTicketMessage[]  @relation("SupportTicketMessageSender")

  @@index([accountType, status])
  @@index([aiRiskScore])
  @@index([lastActiveAt])
  @@index([createdAt])
  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  ipAddress    String?
  userAgent    String?   @db.Text
  device       String?
  browser      String?
  os           String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, revokedAt, lastActiveAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

enum ChangeRequestStatus {
  PENDING_AI_REVIEW
  PENDING_HUMAN_APPROVAL
  APPROVED_AND_APPLIED
  REJECTED
  WITHDRAWN
}

enum SensitiveFieldType {
  IBAN
  NATIONAL_ID
  PHONE_NUMBER
  EMAIL
  BANK_NAME
  ACCOUNT_HOLDER_NAME
  SWIFT_CODE
  FIRST_NAME
  LAST_NAME
}

model ProfileChangeRequest {
  id                 String           @id @default(uuid())
  requestNumber      String           @unique
  affiliateProfileId String
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  fieldType      SensitiveFieldType
  fieldLabel     String
  currentValue   String?            @db.Text
  requestedValue String             @db.Text

  status ChangeRequestStatus @default(PENDING_AI_REVIEW)

  aiRecommendation  String? @db.Text
  aiConfidenceScore Int?

  rejectionReason String?   @db.Text
  reviewedBy      String?
  appliedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profile_change_requests")
}

model ProfileModificationRequest {
  id         String @id @default(uuid())
  providerId String
  provider   User   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  fieldName      String // e.g., 'IBAN', 'NATIONAL_ID', 'PHONE_NUMBER', 'EMAIL'
  fieldLabel     String
  currentValue   String?
  requestedValue String

  category      String    @default("PROFILE")
  requiresOtp   Boolean   @default(false)
  otpVerifiedAt DateTime?
  appliedAt     DateTime?
  metadata      Json?

  status ModificationStatus @default(IN_AI_REVIEW)

  // AI Audit fields
  aiConfidence     Float? // e.g., 95.0
  aiRecommendation String?        @db.Text
  aiAuditStatus    AIAuditResult? // PASSED, NEEDS_HUMAN_REVIEW, REJECTED

  reviewedByAdmin Boolean @default(false)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([status])
  @@map("profile_modification_requests")
}

enum ModificationStatus {
  PENDING_OTP
  IN_AI_REVIEW
  PENDING_HUMAN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum AIAuditResult {
  PASSED
  NEEDS_HUMAN_REVIEW
  FLAGGED
}

// client profile for company and individual
model ClientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String?
  crNumber    String?
  companySize String?
  website     String?
  bio         String?

  // Phase 3A: independent per-role display/progression fields (additive only —
  // see Phase 3 audit). Not yet backfilled or read/written by the app; User's
  // equivalent columns remain the source of truth until Phase 3B/3C/3D.
  firstName            String?
  lastName             String?
  avatarUrl            String?
  currentLevel         String? @default("مستكشف - المستوى 1")
  currentPoints        Int     @default(0)
  pointsToNextLevel    Int?    @default(100)
  completionPercentage Int     @default(0)

  // Step 1: Details
  idNumber String? // National ID / Iqama (10 digits)
  dob      DateTime? // Date of Birth
  country  String?   @default("السعودية")
  city     String?
  industry String? // Occupation/Industry
  address  String?   @db.Text

  // Step 2: Verification / KYC
  isNafathVerified Boolean   @default(false)
  frontIdUrl       String? // ID Front document URL / Storage path
  backIdUrl        String? // ID Back document URL / Storage path
  kycStatus        KYCStatus @default(UNVERIFIED)

  // Step 3: Bank / Wallet
  paymentType   String? // 'bank' | 'wallet'
  bankName      String?
  accountHolder String?
  iban          String?

  // Step 4: Supporting Docs
  supportingDocsUrl String?
  notes             String? @db.Text

  // Step 5: Agreements
  accurateAgreed Boolean @default(false)
  termsAgreed    Boolean @default(false)
  privacyAgreed  Boolean @default(false)

  isProfileComplete Boolean         @default(false)
  clientRequests    ClientRequest[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt

  @@map("client_profiles")
}

enum KYCStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

model ProviderProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName          String?
  headline             String?
  bio                  String?
  hourlyRate           Float?
  yearsOfExperience    Int?
  location             String?
  city                 String?
  country              String?
  availabilityStatus   AvailabilityStatus @default(AVAILABLE)
  completionPercentage Int                @default(0)
  githubUrl            String?
  linkedinUrl          String?
  twitterUrl           String?
  websiteUrl           String?
  languages            String[]           @default([])
  preferences          Json?
  mainSpecialty        String?
  subSpecialties       String[]           @default([])

  // Phase 3A: independent per-role display fields (additive only). Level/
  // points/completion intentionally NOT duplicated here — provider gamification
  // continues to use the existing ProviderGamification.points/currentLevelIndex
  // and this model's own completionPercentage above.
  firstName String?
  lastName  String?
  avatarUrl String?

  rating     Float   @default(5.0)
  isVerified Boolean @default(false)

  skills                   Skill[]
  portfolioItems           PortfolioItem[]
  educations               Education[]
  certificates             Certificate[]
  assessments              ProviderSkillAssessment[]
  accreditationSubmissions AccreditationSubmission[]
  accreditationSamples     AccreditationSample[]
  providerSpecialties      ProviderSpecialty[]
  assessmentAttempts       AssessmentAttempt[]

  // Step 1: Details
  idNumber String? // National ID / Iqama (10 digits)
  dob      DateTime? // Date of Birth
  industry String? // Occupation/Industry
  address  String?   @db.Text

  // Step 2: Verification / KYC
  isNafathVerified Boolean   @default(false)
  frontIdUrl       String? // ID Front document URL
  backIdUrl        String? // ID Back document URL
  certUrls         String[]  @default([])
  kycStatus        KYCStatus @default(UNVERIFIED)

  // Step 3: Bank / Wallet
  paymentType   String? // 'bank' | 'wallet'
  bankName      String?
  accountHolder String?
  iban          String?

  // Payout P2-A: the provider's confirmed PayPal payout destination —
  // entirely separate from bankName/accountHolder/iban above, and from
  // User.email (the login identity). A provider may hold BOTH a bank
  // destination and a PayPal destination simultaneously; Withdrawal.method
  // selects which one a given withdrawal request uses. Deliberately never
  // read as a fallback from User.email anywhere in the codebase — the owner
  // decision behind this field is that a login email must never be assumed
  // to be a correct PayPal-linked address. Editing this field later must
  // NEVER retroactively change the destination already snapshotted onto an
  // existing Withdrawal.paypalEmail (see that field's own comment).
  paypalPayoutEmail String?

  // Step 4: Supporting Docs
  supportingDocsUrl String?
  notes             String? @db.Text

  // Step 5: Agreements
  accurateAgreed Boolean @default(false)
  termsAgreed    Boolean @default(false)
  privacyAgreed  Boolean @default(false)

  isProfileSetupComplete Boolean @default(false)

  // Initial Onboarding Test
  setupTestScore         Float?
  setupTestStatus        String    @default("PENDING") // PENDING, PASSED, FAILED, BANNED
  setupTestBannedUntil   DateTime?
  setupTestCheatAttempts Int       @default(0)

  @@map("provider_profiles")
}

model Skill {
  id               String            @id @default(uuid())
  name             String            @unique
  category         String?
  //   providerProfiles ProviderProfile[]
  providerProfiles ProviderProfile[]

  @@map("skills")
}

model PortfolioItem {
  id                String           @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile  @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  coverImage        String?
  projectUrl        String?
  completionDate    DateTime?
  tags              String[]
  serviceCatalogs   ServiceCatalog[]

  @@index([providerProfileId])
  @@map("portfolio_items")
}

model Education {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  degree            String
  institution       String
  startDate         DateTime?
  endDate           DateTime?
  description       String?

  @@map("educations")
}

model ProviderGamification {
  id         String @id @default(uuid())
  providerId String @unique
  provider   User   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  points            Int   @default(0)
  completedProjects Int   @default(0)
  avgRating         Float @default(0.0)
  currentLevelIndex Int   @default(1) // 1 to 15
  currentCommission Float @default(15.0) // 15% down to 10%

  updatedAt DateTime @updatedAt

  @@map("provider_gamification")
}

model Review {
  id              String          @id @default(uuid())
  providerId      String
  provider        User            @relation("ReviewProvider", fields: [providerId], references: [id], onDelete: Cascade)
  clientId        String?
  client          User?           @relation("ReviewClient", fields: [clientId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  serviceId       String?
  service         ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  clientRequestId String?
  clientRequest   ClientRequest?  @relation(fields: [clientRequestId], references: [id], onDelete: SetNull)
  stageId         String?
  stage           ProjectStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  reviewerRole    String          @default("CLIENT")
  rating          Float
  comment         String?
  createdAt       DateTime        @default(now())

  @@index([providerId])
  @@index([serviceId])
  @@index([projectId])
  @@index([clientRequestId])
  @@index([stageId])
  @@map("reviews")
}

model PointTransaction {
  id         String @id @default(uuid())
  providerId String
  provider   User   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  amount      Int // Positive for gain (+20), Negative for loss (-25)
  reason      String // e.g. "PROJECT_COMPLETED", "EARLY_DELIVERY", "LATE_DELIVERY"
  description String // e.g. "إكمال مشروع بنجاح #PRJ-102"

  createdAt DateTime @default(now())

  @@index([providerId])
  @@map("point_transactions")
}

model GamificationRule {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "GAIN_PROJECT_COMPLETE", "LOSS_LATE_DELIVERY"
  type        RuleType // GAIN or LOSS
  label       String // e.g. "إكمال مشروع بنجاح"
  points      Int // e.g. 20 or -25
  description String?

  @@map("gamification_rules")
}

enum RuleType {
  GAIN
  LOSS
}

model AccountAuditLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category   LogCategory // ROLE_ADDITION, PROFILE_COMPLETION, SECURITY_CHANGE, SYSTEM_AUDIT
  title      String // e.g. "وسيط تسويقي", "مقدم خدمة فرد"
  actionText String // e.g. "إضافة حساب جديد - قناة، موقع ويب"

  status      LogStatus @default(IN_REVIEW)
  statusText  String? // e.g. "مراجعة الذكاء", "متوقع الرد خلال 24 ساعة", "مرفوض - يمكن إعادة تقديم"
  canResubmit Boolean   @default(false)

  metaData   Json? // Additional contextual payloads if needed
  eventType  String? // Stable machine event code
  source     String? // USER, AI, ADMIN, SYSTEM
  severity   String?  @default("INFO") // INFO, WARNING, CRITICAL
  summary    String?  @db.Text
  beforeData Json?
  afterData  Json?
  context    Json?
  requestId  String?
  sessionId  String?
  ipAddress  String?
  device     String?
  actorLabel String?
  occurredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([userId, occurredAt])
  @@index([eventType])
  @@index([source])
  @@index([requestId])
  @@index([sessionId])
  @@map("account_audit_logs")
}

enum LogCategory {
  ROLE_ADDITION
  PROFILE_COMPLETION
  SECURITY_CHANGE
  SYSTEM_AUDIT
}

enum LogStatus {
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

model Certificate {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  name              String
  issuer            String
  issueDate         DateTime?
  credentialUrl     String?

  @@map("certificates")
}

// otb verification for user
model OtpVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      OtpType
  expiresAt DateTime
  context   Json?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

enum OtpType {
  EMAIL
  PHONE
}

enum ProjectStatus {
  DRAFT
  PENDING_SIGNATURE
  PENDING_REVIEW
  OPEN
  IN_PROGRESS
  AWAITING_DELIVERY
  PENDING_APPROVAL
  COMPLETED
  DISPUTED
}

enum ProposalStatus {
  PENDING
  DRAFT
  PENDING_SIGNATURE
  IN_AI_REVIEW
  SUBMITTED
  UNDER_NEGOTIATION
  ACCEPTED
  REJECTED
  CANCELLED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

model Project {
  id          String @id @default(uuid())
  title       String
  description String

  specialty      String
  subSpecialties String[]

  ndaType  String @default("standard")
  ipRights String @default("client")

  provLevel        String?
  provRating       Float?
  provLang         String?
  provLocation     String?
  customConditions String?

  requirements String[]
  outputs      String?
  deliveryDays Int

  budgetType       String  @default("range")
  budgetMin        Float?
  budgetMax        Float?
  budgetFixed      Float?
  budgetHourly     Float?
  allowNegotiation Boolean @default(true)

  splitMilestones Boolean @default(false)
  milestones      Json?

  attachments    String[]
  proposalsCount Int      @default(0)

  status ProjectStatus @default(OPEN)

  clientId String
  client   User   @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)

  providerId String?
  provider   User?   @relation("ProviderProjects", fields: [providerId], references: [id])

  serviceCatalogId String?
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)

  proposals        Proposal[]
  projectProposals ProjectProposal[]
  savedBy          SavedProject[]
  escrow           Escrow?
  contract         Contract?
  conversations    Conversation[]
  reviews          Review[]
  disputes         Dispute[]
  amendments       ProjectAmendment[]

  aiAnalysis Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId, status])
  @@index([serviceCatalogId])
  @@index([clientId, status])
  @@index([status, createdAt])
  @@map("projects")
}

model SavedProject {
  id         String   @id @default(uuid())
  providerId String
  provider   User     @relation("ProviderSavedProjects", fields: [providerId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([providerId, projectId])
  @@map("saved_projects")
}

model Proposal {
  id String @id @default(uuid())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  clientRequestId String?
  clientRequest   ClientRequest? @relation(fields: [clientRequestId], references: [id], onDelete: Cascade)

  providerId String
  provider   User   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  price        Float
  deliveryDays Int
  aiMatchScore Float?
  status       ProposalStatus

  coverLetter String? @db.Text
  workPlan    String? @db.Text

  aiFairPriceMin Float?
  aiFairPriceMax Float?
  aiPriceTag     String?

  attachments ProposalAttachment[]
  createdAt   DateTime             @default(now())

  @@index([providerId, status, createdAt])
  @@index([projectId, status])
  @@index([clientRequestId, status])
  @@map("proposals")
}

model ProposalAttachment {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
}

model Escrow {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  amount           Float
  status           EscrowStatus
  paymentMethod    String?
  paymentReference String?
  fundedAt         DateTime?
  releasedAmount   Float        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("escrows")
}

model ServiceCatalog {
  id         String @id @default(uuid())
  providerId String
  provider   User   @relation("ProviderServices", fields: [providerId], references: [id], onDelete: Cascade)

  title        String
  description  String     @db.Text
  specialtyId  String?
  specialty    Specialty? @relation(fields: [specialtyId], references: [id])
  subSpecialty String?

  portfolioItemId String?
  portfolioItem   PortfolioItem? @relation(fields: [portfolioItemId], references: [id])

  accreditationSampleId String?
  accreditationSample   AccreditationSample? @relation(fields: [accreditationSampleId], references: [id])

  gallery String[] @default([])

  totalAmount Decimal @db.Decimal(10, 2)
  totalDays   Int

  // Status Tracking
  status             ModelStatus @default(PENDING_APPROVAL)
  aiScore            Int?
  aiClarityScore     Int?
  aiFeasibilityScore Int?
  aiReviewSummary    String?     @db.Text
  aiReviewDetails    Json?
  approvedAt         DateTime?

  aiAuditScore         Float?
  aiAuditFeedback      Json?
  aiAuditReport        Json?
  auditRejectionReason String? @db.Text

  viewsCount         Int       @default(0)
  salesCount         Int       @default(0)
  isFeatured         Boolean   @default(false)
  discountPercentage Int?
  offerEndsAt        DateTime?

  stages                     ServiceStage[]
  projects                   Project[]
  reviews                    Review[]
  favorites                  MarketplaceFavorite[]
  cartItems                  CartItem[]
  orderItems                 OrderItem[]
  couponServices             CouponService[]
  // Phase 6 — special offers referencing this service in each role.
  specialOffersAsPrimary     SpecialOffer[]        @relation("SpecialOfferPrimaryService")
  specialOffersAsBeneficiary SpecialOffer[]        @relation("SpecialOfferBeneficiaryService")
  specialOffersAsTarget      SpecialOffer[]        @relation("SpecialOfferTargetService")
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  @@index([providerId])
  @@index([status])
  @@index([specialtyId])
  @@index([accreditationSampleId])
  @@map("service_catalogs")
}

model Cart {
