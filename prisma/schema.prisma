enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Coupon {
  id             String    @id @default(uuid())
  providerId     String?
  provider       User?     @relation("ProviderCoupons", fields: [providerId], references: [id], onDelete: SetNull)
  code           String    @unique
  discountType   String    @default("percentage")
  discountValue  Float
  minimumAmount  Float?
  maxDiscount    Float?
  maxUsesPerUser Int       @default(1)
  startAt        DateTime  @default(now())
  active         Boolean   @default(true)
  expiresAt      DateTime?
  maxUses        Int?
  usedCount      Int       @default(0)

  // Phase 5 — services excluded even when they'd otherwise be in scope
  // (either explicitly listed via CouponService, or implicitly "all
  // services" when CouponService is empty). Postgres array scalar,
  // matching this schema's existing String[] convention (see e.g.
  // ProviderProfile.languages/subSpecialties) rather than introducing a
  // second join table alongside CouponService.
  excludedServiceIds String[] @default([])

  // Internal-only note — never surfaced on the customer-facing coupon
  // validation/checkout responses (cart-checkout.service.ts only ever
  // returns a hand-picked subset of fields, never the raw row).
  internalNote String? @db.Text

  // Company team attribution (Phase 4's CompanyTeamMember). Both nullable —
  // meaningless for PROVIDER_INDIVIDUAL coupons, and optional even for
  // PROVIDER_COMPANY ones. onDelete: SetNull so removing a team member never
  // cascades into deleting coupons they were assigned to/created under.
  assignedToTeamMemberId String?
  assignedToTeamMember   CompanyTeamMember? @relation("CouponAssignedTeamMember", fields: [assignedToTeamMemberId], references: [id], onDelete: SetNull)
  createdByTeamMemberId  String?
  createdByTeamMember    CompanyTeamMember? @relation("CouponCreatedByTeamMember", fields: [createdByTeamMemberId], references: [id], onDelete: SetNull)

  // Company approval workflow. NONE for individual coupons (always
  // effectively approved — see provider-coupon.service.ts) and for legacy
  // rows created before this workflow existed.
  approvalStatus  ApprovalStatus @default(NONE)
  rejectionReason String?

  orders      Order[]
  services    CouponService[]
  redemptions CouponRedemption[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([assignedToTeamMemberId])
  @@index([createdByTeamMemberId])
  @@index([providerId, approvalStatus])
  @@map("coupons")
}

model CouponService {
  couponId  String
  serviceId String
  coupon    Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  service   ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([couponId, serviceId])
  @@index([serviceId])
  @@map("coupon_services")
}

model Order {
  id                      String                   @id @default(uuid())
  orderNumber             String                   @unique
  userId                  String
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                  OrderStatus              @default(PENDING_PAYMENT)
  subtotal                Float
  discount                Float                    @default(0)
  total                   Float
  couponId                String?
  coupon                  Coupon?                  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode              String?
  couponDiscountType      String?
  couponDiscountValue     Float?
  items                   OrderItem[]
  couponRedemption        CouponRedemption?
  specialOfferRedemptions SpecialOfferRedemption[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String   @unique
  amount    Float
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, orderId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// Phase 6 — special offers. Unlike Coupon, applied automatically (no
// customer-entered code). Two shapes, enforced at the application layer
// (special-offer.dto.ts + provider-special-offer.service.ts), not via a DB
// check constraint (this schema has none anywhere):
//   BUNDLE          — ordering primaryService (X) unlocks discountValue% on
//                     beneficiaryService (Y) within validityDays of the
//                     customer's first X order. Requires primary+beneficiary.
//   DIRECT_DISCOUNT — straight discountValue% badge on targetService.
enum SpecialOfferType {
  BUNDLE
  DIRECT_DISCOUNT
}

model SpecialOffer {
  id         String           @id @default(uuid())
  providerId String
  provider   User             @relation("ProviderSpecialOffers", fields: [providerId], references: [id], onDelete: Cascade)
  type       SpecialOfferType
  name       String

  primaryServiceId     String?
  primaryService       ServiceCatalog? @relation("SpecialOfferPrimaryService", fields: [primaryServiceId], references: [id], onDelete: SetNull)
  beneficiaryServiceId String?
  beneficiaryService   ServiceCatalog? @relation("SpecialOfferBeneficiaryService", fields: [beneficiaryServiceId], references: [id], onDelete: SetNull)
  targetServiceId      String?
  targetService        ServiceCatalog? @relation("SpecialOfferTargetService", fields: [targetServiceId], references: [id], onDelete: SetNull)

  // Percentage (1–100), same Float convention as Coupon.discountValue.
  discountValue   Float
  validityDays    Int?
  startAt         DateTime  @default(now())
  expiresAt       DateTime?
  badgeText       String
  customerMessage String?   @db.Text
  internalNote    String?   @db.Text
  active          Boolean   @default(true)
  usedCount       Int       @default(0)

  assignedToTeamMemberId String?
  assignedToTeamMember   CompanyTeamMember? @relation("SpecialOfferAssignedTeamMember", fields: [assignedToTeamMemberId], references: [id], onDelete: SetNull)
  createdByTeamMemberId  String?
  createdByTeamMember    CompanyTeamMember? @relation("SpecialOfferCreatedByTeamMember", fields: [createdByTeamMemberId], references: [id], onDelete: SetNull)

  approvalStatus  ApprovalStatus @default(NONE)
  rejectionReason String?

  redemptions SpecialOfferRedemption[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([providerId, approvalStatus])
  @@index([primaryServiceId])
  @@index([beneficiaryServiceId])
  @@index([targetServiceId])
  @@index([assignedToTeamMemberId])
  @@index([createdByTeamMemberId])
  @@map("special_offers")
}

// Mirrors CouponRedemption, except orderId is NOT globally unique: one
// order may legitimately redeem several different offers (e.g. a bundle
// on one item and a direct discount on another), so uniqueness is per
// (offer, user, order) only.
model SpecialOfferRedemption {
  id        String   @id @default(uuid())
  offerId   String
  userId    String
  orderId   String
  amount    Float
  createdAt DateTime @default(now())

  offer SpecialOffer @relation(fields: [offerId], references: [id])
  user  User         @relation(fields: [userId], references: [id])
  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId, orderId])
  @@index([offerId, userId])
  @@index([orderId])
  @@map("special_offer_redemptions")
}

model OrderItem {
