  commissionRatePercentage Float   @default(5.0)

  notifyOnNewReferral   Boolean @default(true)
  sharePerformanceStats Boolean @default(false)

  // Phase 3A: independent per-role display fields (additive only). No new
  // avatarUrl/currentLevel/completionPercentage/points here — this model
  // already has its own independent avatarUrl, currentLevel and
  // completionPercentage above; affiliate points remain out of scope (no
  // points-based progress concept exists for this role today).
  firstName String?
  lastName  String?

  // Marketing Profile Tab
  avatarUrl         String?
  bio               String?                  @db.Text
  marketingChannels AffiliateChannelHandle[]

  // Bank & KYC Tab
  bankName          String?
  accountHolderName String?
  iban              String?
  swiftCode         String?
  identityVerified  Boolean @default(false)
  kycDocumentUrl    String?

  // Commission Preferences
  payoutMethod        String? @default("BANK_TRANSFER") // BANK_TRANSFER, PAYONEER, etc.
  minimumPayoutAmount Float   @default(100.0)

  // System Calculated
  completionPercentage Int @default(0)

  referrals             Referral[]
  commissionLogs        CommissionLog[]
  channelMetrics        AffiliateChannelMetric[]
  customLinks           ReferralCustomLink[]
  profileChangeRequests ProfileChangeRequest[]

