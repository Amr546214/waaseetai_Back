enum WithdrawalStatus {
  PENDING
  APPROVED
  // Payout P1: an active PayoutAttempt exists for this withdrawal and it
  // must remain reserved. Deliberately NO separate FAILED value — a failed
  // PayoutAttempt reverts the Withdrawal to APPROVED (indistinguishable
  // from "never attempted yet", which is the correct, minimal semantics;
  // the PayoutAttempt rows themselves carry the failure history).
  PROCESSING
  REJECTED
  COMPLETED
  // Payout P3-A: PayPal reported, AFTER this withdrawal already reached
  // COMPLETED, that the money was subsequently returned/refunded/reversed
  // (see PayoutAttemptStatus.REVERSED and PayoutAttempt.paypalTerminalStatus
  // for the full reasoning). Deliberately NOT the same as a failed payout
  // reverting to APPROVED: real money already moved once here, so this must
  // never be silently reopened for another automatic payout attempt — only
  // PayoutService.markAttemptReversed() may ever write this value, and only
  // FROM COMPLETED. Requires explicit admin/manual review (a future phase's
  // responsibility, not decided by this state alone).
  REVERSED
}

model Withdrawal {
  id            String  @id @default(uuid())
  userId        String
  user          User    @relation("WithdrawalUser", fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String  @default("SAR")
  method        String
  accountName   String?
  accountNumber String?
  iban          String?

  // Payout P2-A: the IMMUTABLE PayPal destination snapshot — populated once,
  // at creation time, by copying ProviderProfile.paypalPayoutEmail (never
  // User.email) for a withdrawal whose method is 'paypal'. Null for every
  // non-PayPal (e.g. bank_transfer) withdrawal. This snapshot is what any
  // future payout execution reads — the live ProviderProfile.paypalPayoutEmail
  // is deliberately NEVER re-read after this row is created, so a provider
  // changing their PayPal address later can never retroactively alter where
  // an already-created withdrawal will be paid out.
  paypalEmail     String?
  status          WithdrawalStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?            @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  adminNote       String?
  referenceId     String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Payout P1: the destination snapshot for payout purposes IS this row's
  // own accountName/accountNumber/iban above, captured once at creation and
  // never re-read live from the provider's profile — every PayoutAttempt
  // for this withdrawal shares that single, immutable destination.
  payoutAttempts PayoutAttempt[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("withdrawals")
}

enum PayoutAttemptStatus {
  // Durable local row exists; the external payout call has not yet been
  // confirmed accepted by the provider — it may not have been sent yet, may
  // be in flight, or may have failed with an unknown outcome. P1 never
  // moves a row past this state itself (no external call exists yet); P2/P3
  // will drive PENDING -> PROCESSING/FAILED/COMPLETED using the primitives
  // this batch provides.
  PENDING
  // Provider has synchronously acknowledged/accepted the payout; awaiting a
  // terminal outcome (webhook or reconciliation).
  PROCESSING
  // Authoritative success — from a verified webhook or a reconciliation
  // lookup, never merely because an admin approved the withdrawal.
  COMPLETED
  // Authoritative failure — a definite synchronous rejection, a verified
  // webhook failure, or a reconciliation lookup confirming the attempt
  // never reached the provider. Terminal for this attempt; a retry is a
  // NEW PayoutAttempt row with the next attemptNumber, never a status
  // change on this one.
  FAILED
  // Payout P3-A: reachable ONLY from COMPLETED, via
  // PayoutService.markAttemptReversed() — the ONE explicit, deliberately
  // narrow exception to every other primitive's rule that COMPLETED is
  // permanently final. Represents PayPal reporting, AFTER a payout already
  // succeeded (PayoutAttemptStatus.COMPLETED), that the money was
  // subsequently returned/refunded/reversed. This is intentionally a SINGLE
  // local umbrella state for all three of PayPal's own distinct terminal-
  // after-success item statuses (RETURNED / REFUNDED / REVERSED) — the
  // financial mechanics differ between them, but from this local state
  // machine's perspective the consequence is identical: the payout that
  // once looked complete no longer safely is, and must never be
  // automatically retried or have its Withdrawal reopened to APPROVED. The
  // EXACT PayPal status that triggered this is preserved separately, never
  // collapsed away, in PayoutAttempt.paypalTerminalStatus below — NOT the
  // same semantic class as failureReason (which means "this payment never
  // succeeded at all"), so it must never be written there.
  //
  // Explicitly NOT part of the "active attempt" set (active_attempt_unique
  // below still only covers PENDING/PROCESSING) — a reversed attempt is not
  // "in flight," it is terminal; it simply must not be confused with, or
  // silently treated the same as, PayoutAttemptStatus.FAILED.
  REVERSED
}

model PayoutAttempt {
  id String @id @default(uuid())

  withdrawalId String
  withdrawal   Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  // 'PAYPAL' today; a plain string (not an enum) so a second payout
  // provider never needs a schema migration to add, only a new value.
  provider String

  // 1, 2, 3... — every attempt ever made for this withdrawal, active or
  // terminal, claims a distinct ordinal forever. Allocated inside the same
  // SERIALIZABLE transaction that creates the row; @@unique below (not
  // count()+1 alone) is the actual concurrency backstop.
  attemptNumber Int

  // Our own idempotency key, generated deterministically from
  // (withdrawalId, attemptNumber) and stored BEFORE any future external
  // call — see prisma-retry.util.ts-adjacent payout-attempt.util.ts. Stable
  // across an HTTP retry of the SAME attempt; different for a genuinely new
  // one. No secret material involved.
  senderBatchId String @unique

  // The provider's own references, populated once known (never before the
  // call, unlike senderBatchId above).
  payoutBatchId String?
  payoutItemId  String? @unique // the eventual webhook correlation key

  status        PayoutAttemptStatus @default(PENDING)
  failureReason String?

  // Payout P3-A: the EXACT PayPal item status that caused a REVERSED
  // transition (e.g. "RETURNED" | "REFUNDED" | "REVERSED") — populated
  // ONLY by PayoutService.markAttemptReversed(), never trusted from
  // arbitrary caller/request input, and never written by any other
  // primitive. Deliberately a SEPARATE field from failureReason above:
  // failureReason means "PayPal never completed this payment" (the
  // FAILED semantic class); this field means "PayPal DID complete it, and
  // a later event reported it reversed" — a fundamentally different
  // semantic class that failureReason must not be overloaded to also
  // carry. A plain string (not an enum), matching this model's own
  // `provider` field's precedent, so a future PayPal status this project
  // hasn't seen yet never needs a migration to record — but the only
  // values this codebase currently intends to ever write here are
  // "RETURNED", "REFUNDED", or "REVERSED" (enforced by whichever future
  // P3-D code path actually populates it, not by this column itself).
  paypalTerminalStatus String?

  // Sanitized last-known API/webhook response for reconciliation — P2/P3's
  // responsibility to ensure nothing secret (tokens, full headers) is ever
  // written here; P1 only defines the column.
  rawResponse Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Payout P3-A: every durably-recorded PayPal webhook event this
  // PayoutAttempt has been correlated to, once known — see
  // PaypalWebhookEvent's own comment. No processing logic exists yet
  // (P3-D's responsibility); this is schema only.
  webhookEvents PaypalWebhookEvent[]

  // Attempt-history integrity: no two attempts for the same withdrawal ever
  // share an ordinal, active or terminal.
  @@unique([withdrawalId, attemptNumber])
  // THE hard DB backstop: at most one PENDING/PROCESSING PayoutAttempt can
  // ever exist per withdrawal, enforced by Postgres itself via a genuine
  // partial unique index (requires previewFeatures = ["partialIndexes"]
  // above). A second concurrent attempt's INSERT fails atomically here,
  // regardless of what any application-level pre-check believed.
  //
  // Payout P3-A: deliberately left EXACTLY as-is — REVERSED is intentionally
  // NOT added to this set. A reversed attempt is terminal, not "in flight,"
  // and must never be treated as an active attempt that blocks a new one at
  // this layer; the Withdrawal's own REVERSED status (see WithdrawalStatus)
  // is what prevents the ordinary send-payout path from ever treating a
  // reversed withdrawal as eligible (it is no longer APPROVED).
  @@unique([withdrawalId], where: raw("status IN ('PENDING','PROCESSING')"), map: "active_attempt_unique")
  // Query-performance indexes ONLY — deliberately NOT the uniqueness
  // backstop (see active_attempt_unique below). A future reader must never
  // mistake this for enforcing "at most one active attempt."
  @@index([withdrawalId, status])
  @@index([status, createdAt])
  @@map("payout_attempts")
}

// Payout P3-A: durable PayPal webhook-event deduplication — added ahead of
// P3-D's actual webhook processing, schema only, no processing code exists
// yet. paypalEventId's uniqueness is THE primary dedup key; paypalCreateTime
// is only an ordering HINT for distinguishing a genuinely later event from a
// redelivered older one, never a substitute for that uniqueness guarantee
// (do not assume it alone provides a perfect total ordering).
//
// CRITICAL design note for whoever implements P3-D: claiming an event here
// (inserting/updating this row) and applying its corresponding
// PayoutAttempt/Withdrawal state transition MUST happen inside the SAME
// database transaction. If dedup-claiming were a separate, independent step
// from the financial state transition, a crash between "event marked
// PROCESSED" and "PayoutAttempt/Withdrawal actually updated" could silently
// lose a real PayPal event forever (the dedup key would then incorrectly
// make every future redelivery of the same event a no-op, even though the
// financial transition never actually happened). The `status` field below
// exists specifically so that failure mode is representable and
// recoverable: a row stuck at RECEIVED (never reached PROCESSED) is a clear,
// queryable signal that something needs manual/automatic re-processing —
// never a silently-lost event.
model PaypalWebhookEvent {
  id String @id @default(uuid())

  // PayPal's own globally-unique event identifier.
  paypalEventId String @unique

  eventType    String
  resourceType String?

  // PayPal's own reported event creation time, if present — see this
  // model's own top comment: an ordering HINT only, not a dedup key.
  paypalCreateTime DateTime?

  // Correlates this event to the PayoutAttempt it concerns, once known.
  // Optional because the correlating identifier (payoutBatchId/
  // payoutItemId/senderBatchId, whichever the event actually carries) might
  // not always be resolvable at the moment the event is first durably
  // recorded — never dropping the event for that reason is the whole point
  // of this table.
  payoutAttemptId String?
  payoutAttempt   PayoutAttempt? @relation(fields: [payoutAttemptId], references: [id], onDelete: SetNull)

  // Crash-safety (see this model's own top comment): RECEIVED (durably
  // claimed, not yet applied) -> PROCESSED (the corresponding financial
  // state transition committed, in the SAME transaction as this status
  // write) or FAILED (a genuine anomaly during processing — never silently
  // dropped, always visible for investigation).
  status PaypalWebhookEventStatus @default(RECEIVED)

  // Sanitized — never the raw request body with any secret/PII beyond what
  // PayPal's own event payload already exposes; enforcing that is P3-D's
  // responsibility, this column only defines the shape.
  rawEvent Json?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  // Payout P3-D concurrency-review addition (the ONLY schema change that
  // review's final verdict required): the compare-and-swap "freshness
  // token" a stale-event reclaim uses to distinguish "another request is
  // actively processing this RECEIVED/FAILED row right now" from "the
  // worker that claimed it crashed and abandoned it" — see
  // payout-webhook.service.ts's claim/reclaim algorithm for the full
  // reasoning. Deliberately NOT relied upon via Prisma's implicit
  // auto-bump-on-any-update behavior (unverifiable in this project without
  // a live DB call, which is outside this task's scope) — every write that
  // needs a fresh token sets this column EXPLICITLY in its own `data`,
  // making freshness fully deterministic and unit-testable at the
  // application level instead of depending on unconfirmed ORM/engine
  // internals.
  updatedAt DateTime @updatedAt

  @@index([payoutAttemptId])
  @@index([status, createdAt])
  @@map("paypal_webhook_events")
}

enum PaypalWebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClientOnboarding {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentUrl     String
  documentName    String
  documentType    String
  status          OnboardingStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("client_onboarding")
}

model ClientRequest {
  id              String        @id @default(uuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  specialtyId     String
  specialty       Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  title          String
  description    String   @db.Text
  subSpecialties String[]
  requiredSkills String[]

  // Budget & Timeline
  budgetType           BudgetType @default(FIXED) // FIXED, RANGE, HOURLY
  minBudget            Float?
  maxBudget            Float?
  expectedDurationDays Int?

  // Conditions & Requirements
  preferredProviderType ProviderTypePreference @default(ANY) // INDIVIDUAL, COMPANY, ACCREDITED_ONLY, ANY
  requiresNda           Boolean                @default(false)
  attachments           String[]
  outputs               String?                @db.Text
  customConditions      String?                @db.Text
  ipRights              String                 @default("client")
  providerPreferences   Json?
  allowNegotiation      Boolean                @default(true)
  splitMilestones       Boolean                @default(false)
  milestones            Json?

  // AI Matching & System Attributes
  aiAnalyzedSummary  String?       @db.Text
  aiComplexityRating String? // LOW, MEDIUM, HIGH, COMPLEX
  status             RequestStatus @default(OPEN) // DRAFT, OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  proposalsCount     Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals Proposal[]
  reviews   Review[]
  disputes  Dispute[]

  @@index([clientProfileId])
  @@index([specialtyId])
  @@index([status])
  @@map("client_requests")
}

model WalletTransaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // 'DEPOSIT', 'ESCROW_LOCK', 'ESCROW_RELEASE', 'REFUND'
  amount        Float
  currency      String   @default("SAR")
  status        String   @default("COMPLETED") // 'PENDING', 'COMPLETED', 'FAILED'
  paymentMethod String? // 'MOYASAR_CARD', 'MOYASAR_APPLEPAY', 'BANK_TRANSFER'
  referenceId   String?  @unique // Moyasar payment id or bank ref; globally idempotent
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// PayPal Sandbox wallet-deposit integration (separate gateway from Moyasar).
// One row per PayPal order, created PENDING at order-create time so the
// authenticated capture endpoint and the webhook can both converge on the
// same record instead of trusting either path alone.
enum PaypalPaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model PaypalPayment {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference       String              @unique // internal deposit reference (UUID), mirrors WalletTransaction convention
  paypalOrderId   String              @unique
  paypalCaptureId String?             @unique // set only once capture succeeds; globally idempotent
  amount          Decimal             @db.Decimal(12, 2) // USD, exact decimal — no float comparisons for money
  currency        String              @default("USD")
  status          PaypalPaymentStatus @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, createdAt])
  @@map("paypal_payments")
}

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  source         String?

  @@map("newsletter_subscribers")
}

// ─── Company team members ─────────────────────────────────────────────
// Real team roster for PROVIDER_COMPANY accounts. Each row is owned and
// managed by the company account (companyOwnerId). Deliberately NOT an
// auth identity: team members have no password/session/JWT of their own.

enum TeamMemberType {
  PROVIDER
  EMPLOYEE
}

enum TeamMemberStatus {
  ACTIVE
  PENDING
  INACTIVE
}

model CompanyTeamMember {
  id             String           @id @default(uuid())
  companyOwnerId String
  companyOwner   User             @relation("CompanyTeamMembers", fields: [companyOwnerId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String?
  jobTitle       String
  memberType     TeamMemberType
  status         TeamMemberStatus @default(PENDING)
  avatarUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Phase 5 — coupons assigned to / attributed to this team member.
  assignedCoupons Coupon[] @relation("CouponAssignedTeamMember")
  createdCoupons  Coupon[] @relation("CouponCreatedByTeamMember")

  // Phase 6 — special offers assigned to / attributed to this team member.
  assignedSpecialOffers SpecialOffer[] @relation("SpecialOfferAssignedTeamMember")
  createdSpecialOffers  SpecialOffer[] @relation("SpecialOfferCreatedByTeamMember")

  @@unique([companyOwnerId, email])
  @@index([companyOwnerId, memberType, status])
  @@map("company_team_members")
}
