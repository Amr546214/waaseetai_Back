  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  proofFiles  AccreditationProofFile[]
  aiAuditLogs AiAccreditationAuditLog[]

  @@map("provider_accreditation_submissions")
}

model AccreditationProofFile {
  id                        String                  @id @default(uuid())
  accreditationSubmissionId String
  submission                AccreditationSubmission @relation(fields: [accreditationSubmissionId], references: [id], onDelete: Cascade)

  fileType ProofFileType // PROOF_DOCUMENT (إثبات ملكية) or WORK_SAMPLE (نموذج عمل)
  fileUrl  String
  fileName String
  fileSize Int?

  // Stored AI Vision Evaluation Per Image — currently unused/dead columns
  // (no code in src/ reads or writes them; the live accreditation evaluation
  // path persists its Gemini-backed result on AccreditationSample instead,
  // see aiScore/aiQualityRating/aiFeedbackAr below). Kept as-is per the
  // no-schema-migration constraint.
  aiAuthenticityScore    Float?
  aiDetectedQualityScore Float?
  aiTechnicalAnalysis    Json? // Breakdown (extracted stack, visual polish, copyright checks)

  createdAt DateTime @default(now())

  @@map("provider_accreditation_proofs")
}

model AiAccreditationAuditLog {
  id                        String                  @id @default(uuid())
  accreditationSubmissionId String
  submission                AccreditationSubmission @relation(fields: [accreditationSubmissionId], references: [id], onDelete: Cascade)

  promptTokensUsed     Int?
  completionTokensUsed Int?
  rawAiResponse        Json
  evaluatedAt          DateTime @default(now())

  @@map("provider_accreditation_audit_logs")
}

model AssessmentAttempt {
  id                  String            @id @default(uuid())
  providerSpecialtyId String
  providerSpecialty   ProviderSpecialty @relation(fields: [providerSpecialtyId], references: [id], onDelete: Cascade)
  providerProfileId   String
  providerProfile     ProviderProfile   @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  specialtyId         String
  specialty           Specialty         @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  subSpecialtiesSnapshot Json? // Array of chosen sub-specialties
  analyzedAssetsSnapshot Json? // Metadata of analyzed portfolio files

  questionsPayload Json // Full array of 20 questions (with answer keys)
  submittedAnswers Json? // Submitted answers map

  totalQuestions Int      @default(20)
  score          Float? // Percentage (e.g. 85.0%)
  isPassed       Boolean  @default(false)
  feedbackAr     String?  @db.Text
  strengths      String[]
  weaknesses     String[]

  status           AssessmentStatus @default(IN_PROGRESS)
  timeLimitMinutes Int              @default(15)
  startedAt        DateTime         @default(now())
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerSpecialtyId])
  @@index([providerProfileId])
  @@map("assessment_attempts")
}

enum AssessmentStatus {
  IN_PROGRESS
  STREAMING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum BudgetType {
  FIXED
  RANGE
  HOURLY
}

enum ProviderTypePreference {
  INDIVIDUAL
  COMPANY
  ACCREDITED_ONLY
  ANY
}

enum RequestStatus {
  DRAFT
  PENDING_SIGNATURE
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Dispute {
  id             String        @id @default(uuid())
  requestId      String?
  request        ClientRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  openedById     String
  openedBy       User          @relation("DisputesOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  againstUserId  String?
  againstUser    User?         @relation("DisputesAgainstUser", fields: [againstUserId], references: [id], onDelete: SetNull)
  resolvedById   String?
  resolvedBy     User?         @relation("DisputesResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  status         DisputeStatus @default(OPEN)
  reason         String
  description    String        @db.Text
  evidence       String[]      @default([])
  resolution     String?
  resolutionNote String?       @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([requestId])
  @@index([projectId])
  @@index([openedById])
  @@map("disputes")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Withdrawal {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation("WithdrawalUser", fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String           @default("SAR")
  method         String
  accountName    String?
  accountNumber  String?
  iban           String?
  status         WithdrawalStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?            @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  adminNote      String?
  referenceId    String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("withdrawals")
}

enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClientOnboarding {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentUrl    String
  documentName   String
  documentType   String
  status         OnboardingStatus @default(PENDING)
  rejectionReason String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("client_onboarding")
}

model ClientRequest {
  id              String        @id @default(uuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  specialtyId     String
  specialty       Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  title          String
  description    String   @db.Text
  subSpecialties String[]
  requiredSkills String[]

  // Budget & Timeline
  budgetType           BudgetType @default(FIXED) // FIXED, RANGE, HOURLY
  minBudget            Float?
  maxBudget            Float?
  expectedDurationDays Int?

  // Conditions & Requirements
  preferredProviderType ProviderTypePreference @default(ANY) // INDIVIDUAL, COMPANY, ACCREDITED_ONLY, ANY
  requiresNda           Boolean                @default(false)
  attachments           String[]
  outputs               String?                @db.Text
  customConditions      String?                @db.Text
  ipRights              String                 @default("client")
  providerPreferences   Json?
  allowNegotiation      Boolean                @default(true)
  splitMilestones       Boolean                @default(false)
  milestones            Json?

  // AI Matching & System Attributes
  aiAnalyzedSummary  String?       @db.Text
  aiComplexityRating String? // LOW, MEDIUM, HIGH, COMPLEX
  status             RequestStatus @default(OPEN) // DRAFT, OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  proposalsCount     Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals Proposal[]
  reviews   Review[]
  disputes  Dispute[]

  @@index([clientProfileId])
  @@index([specialtyId])
  @@index([status])
  @@map("client_requests")
}

model WalletTransaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // 'DEPOSIT', 'ESCROW_LOCK', 'ESCROW_RELEASE', 'REFUND'
  amount        Float
  currency      String   @default("SAR")
  status        String   @default("COMPLETED") // 'PENDING', 'COMPLETED', 'FAILED'
  paymentMethod String? // 'MOYASAR_CARD', 'MOYASAR_APPLEPAY', 'BANK_TRANSFER'
  referenceId   String?  @unique // Moyasar payment id or bank ref; globally idempotent
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// PayPal Sandbox wallet-deposit integration (separate gateway from Moyasar).
// One row per PayPal order, created PENDING at order-create time so the
// authenticated capture endpoint and the webhook can both converge on the
// same record instead of trusting either path alone.
enum PaypalPaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model PaypalPayment {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference       String              @unique // internal deposit reference (UUID), mirrors WalletTransaction convention
  paypalOrderId   String              @unique
  paypalCaptureId String?             @unique // set only once capture succeeds; globally idempotent
  amount          Decimal             @db.Decimal(12, 2) // USD, exact decimal — no float comparisons for money
  currency        String              @default("USD")
  status          PaypalPaymentStatus @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, createdAt])
  @@map("paypal_payments")
}

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  source         String?

  @@map("newsletter_subscribers")
}
