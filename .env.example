# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5009
NODE_ENV=production
RUN_DB_MIGRATIONS=false
RUN_DB_PUSH=true
DB_HOST=postgres
DB_PORT=5432
VPS_API_PORT=5010
POSTGRES_DB=waseetai_db
POSTGRES_USER=waseetai_app
POSTGRES_PASSWORD="replace_with_a_long_random_password"
API_PUBLIC_URL="https://api.example.com"

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Connection String Template:
# postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public
#
# Examples based on the new docker-compose.databases.yml structure:
# Dev:  DATABASE_URL="postgresql://waseetai_dev:secure_dev_password_123@localhost:5432/waseetai_db_dev?schema=public"
# Main: DATABASE_URL="postgresql://waseetai_prod:HighlySecureProdPassword987!@localhost:5433/waseetai_db_main?schema=public"
#
DATABASE_URL="postgresql://waseetai_app:change_this_password@postgres:5432/waseetai_db?schema=public"

# ==========================================
# SECURITY / JWT
# ==========================================
JWT_SECRET="insert_super_secret_jwt_key_here"
OTP_SECRET="insert_separate_high_entropy_otp_hmac_key_here"

# ==========================================
# MOYASAR PAYMENT GATEWAY
# Use pk_test/sk_test together in development and pk_live/sk_live in production.
# Never expose the secret key to the frontend.
# ==========================================
MOYASAR_PUBLISHABLE_KEY="pk_test_insert_moyasar_publishable_key_here"
MOYASAR_SECRET_KEY="sk_test_insert_moyasar_secret_key_here"
FRONTEND_URL="https://app.example.com"
CORS_ORIGINS="https://app.example.com"

# ==========================================
# OPENAI AI ENGINE CONFIGURATION
# ==========================================
OPENAI_API_KEY="sk-proj-insert_openai_api_key_here"

# ==========================================
# SMTP / EMAIL CONFIGURATION
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="noreply@waseetai.com"
SMTP_PASS="insert_smtp_password_here"
