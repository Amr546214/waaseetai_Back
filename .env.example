# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5009
NODE_ENV=production
RUN_DB_MIGRATIONS=false
RUN_DB_PUSH=false
RUN_DB_PUSH_ACCEPT_DATA_LOSS=false

# Payout P3-D (automated PayPal payouts) — excluded from this release; its
# tables (payout_attempts, paypal_webhook_events) have no migration yet.
# Must default to disabled. Do not set to true until that migration has
# been applied to this environment's database.
PAYOUT_AUTOMATION_ENABLED=false

# P-LG-012 affiliate commission engine (USD) — must default to disabled.
AFFILIATE_COMMISSION_ENGINE_ENABLED=false
DB_HOST=postgres
DB_PORT=5432
VPS_API_PORT=5010
POSTGRES_DB=waseetai_db
POSTGRES_USER=waseetai_app
POSTGRES_PASSWORD="replace_with_a_long_random_password"
API_PUBLIC_URL="https://api.example.com"

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Connection String Template:
# postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public
#
# Examples based on the new docker-compose.databases.yml structure:
# Dev:  DATABASE_URL="postgresql://waseetai_dev:secure_dev_password_123@localhost:5432/waseetai_db_dev?schema=public"
# Main: DATABASE_URL="postgresql://waseetai_prod:HighlySecureProdPassword987!@localhost:5433/waseetai_db_main?schema=public"
#
DATABASE_URL="postgresql://waseetai_app:change_this_password@postgres:5432/waseetai_db?schema=public"

# ==========================================
# SECURITY / JWT
# ==========================================
JWT_SECRET="insert_super_secret_jwt_key_here"
OTP_SECRET="insert_separate_high_entropy_otp_hmac_key_here"

# ==========================================
# RATE LIMITING
# RATE_LIMIT_ENABLED controls the global API limiter, the auth limiter, and
# the AI limiter together. Keep it "true" (or unset) in production. Set it to
# the literal string "false" ONLY for local/DEV QA testing to stop the
# limiters from returning HTTP 429 — never disable this in production.
# ==========================================
RATE_LIMIT_ENABLED=true

# ==========================================
# AUTH RATE LIMITING
# Limits login/register/OTP/forgot-password attempts per IP.
# Leave unset in production to keep the safe default (10 attempts / hour).
# For local dev/QA testing where the limiter gets in the way, raise it, e.g.:
# AUTH_RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_WINDOW_MS=3600000
# ==========================================
AUTH_RATE_LIMIT_WINDOW_MS=3600000
AUTH_RATE_LIMIT_MAX=10

# ==========================================
# PAYPAL PAYMENT GATEWAY (the only wallet deposit rail, USD)
# PAYPAL_ENV selects the API base URL: "sandbox" -> api-m.sandbox.paypal.com,
# "live" -> api-m.paypal.com. Only "sandbox" is supported/tested for now.
# PAYPAL_CLIENT_SECRET must never be sent to the frontend or logged.
# PAYPAL_WEBHOOK_ID comes from the PayPal Dashboard once a webhook is
# registered against this app's webhook endpoint.
# ==========================================
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
FRONTEND_URL="https://app.example.com"
CORS_ORIGINS="https://app.example.com"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace_with_a_random_password_of_at_least_12_characters"

# ==========================================
# WASEETAI MICROSERVICE CONFIGURATION
# Centralized client: src/services/ai/waseet-ai/waseet-ai.client.ts (the ONLY
# place allowed to read the bearer token). Used server-side by the
# authenticated help-assistant: the chat socket gateway
# (src/sockets/help-assistant-chat.gateway.ts) and the TTS route
# (src/routes/help-assistant-tts.routes.ts). If unset, the client reports
# isConfigured() === false and every call fails with NOT_CONFIGURED without
# making a network request (the assistant degrades gracefully).
# WASEET_AI_BASE_URL is optional (defaults to the documented Cloud Run URL).
# WASEET_AI_BEARER_TOKEN must come from your secret store — never commit a
# real value, never expose it to the Angular app.
# ==========================================
WASEET_AI_BASE_URL="https://waseet-ai-api-1041761245251.us-central1.run.app"
WASEET_AI_BEARER_TOKEN=
# WASEET_AI_TIMEOUT_MS="30000"
# WASEET_AI_STREAM_TIMEOUT_MS="90000"

# ==========================================
# SMTP / EMAIL CONFIGURATION
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="noreply@waseetai.com"
SMTP_PASS="insert_smtp_password_here"

# ==========================================
# SMS / LOGIN PHONE OTP CONFIGURATION
# Gates the phone OTP challenge issued on login for accounts with
# phoneOtpEnabled=true (see auth.service.ts). Leave SMS_ENABLED unset/false
# in dev/staging — the code is logged instead of sent (see
# notification.service.ts sendSmsOtp), so the login flow still works without
# a real gateway. Set SMS_ENABLED=true only once SMS_PROVIDER's credentials
# are wired up in sendSmsOtp() — no provider is implemented yet.
# ==========================================
# SMS_ENABLED="false"
# SMS_PROVIDER="twilio"
# SMS_SENDER_ID="WaseetAI"

# ==========================================
# INTERNAL LLM LAYER (src/services/llm) — features built in-house (not the WaseetAI-linked ones)
# All of LLM_PROVIDER, a key and LLM_MODEL are REQUIRED; if any is missing the in-house AI features answer 503 NOT_CONFIGURED.
# No model name lives in code. Only LLM_PROVIDER=gemini is implemented.
# ==========================================
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
# Secondary in-memory circuit breaker (the primary budget is set in the provider console). Requires both prices.
# LLM_MONTHLY_BUDGET_USD=
# LLM_PRICE_INPUT_PER_MILLION_USD=
# LLM_PRICE_OUTPUT_PER_MILLION_USD=
# LLM_RATE_PER_HOUR=10
# LLM_CACHE_TTL_MINUTES=15
