{
	"name": "waseetai-backend",
	"version": "1.0.0",
	"description": "Backend for Waseet AI - Advanced AI Matchmaking Marketplace",
	"main": "dist/app.js",
	"scripts": {
		"prisma:generate": "npx prisma generate",
		"prisma:deploy": "npx prisma migrate deploy",
		"prestart": "npx prisma generate && npx prisma migrate deploy",
		"start": "nodemon src/app.ts",
		"build": "tsc",
		"typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
		"test:ai-engine:authorization": "tsx --require ./tests/ai-engine/test-bootstrap.cjs --test --test-concurrency=1 tests/ai-engine/authorization.test.ts",
		"start:prod": "node dist/app.js",
		"db:migrate": "npx prisma migrate dev",
		"prisma:migrate:deploy": "npx prisma migrate deploy",
		"db:studio": "npx prisma studio",
		"db:seed": "tsx prisma/seed.ts",
		"db:seed:e2e": "tsx prisma/seed-e2e.ts",
		"audit:existing": "npx -y tsx scripts/audit-existing-models.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"bcrypt": "^6.0.0",
		"cloudinary": "^2.11.0",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"google-auth-library": "^11.0.2",
		"helmet": "^8.2.0",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.11.0",
		"multer": "^2.2.0",
		"nodemailer": "^9.0.1",
		"openai": "^6.48.0",
		"prisma": "^7.8.0",
		"pg": "^8.22.0",
		"socket.io": "^4.8.3",
		"swagger-ui-express": "^5.0.1",
		"tsx": "^4.19.2",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.0.0",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.20.0",
		"@types/swagger-ui-express": "^4.1.8",
		"nodemon": "^3.1.14",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	}
}
