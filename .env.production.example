# Copy to .env on the VPS and replace every placeholder.
NODE_ENV=production
PORT=5009
RUN_DB_MIGRATIONS=false
RUN_DB_PUSH=false
RUN_DB_PUSH_ACCEPT_DATA_LOSS=false

# Payout P3-D (automated PayPal payouts) — excluded from this release; its
# tables (payout_attempts, paypal_webhook_events) have no migration yet.
# Must default to disabled. Do not set to true until that migration has
# been applied to this environment's database.
PAYOUT_AUTOMATION_ENABLED=false
DB_HOST=postgres
DB_PORT=5432
VPS_API_PORT=5010
POSTGRES_DB=waseetai_db
POSTGRES_USER=waseetai_app
POSTGRES_PASSWORD="replace_with_a_long_random_password"

# Internal Docker network URL. Do not use localhost here.
DATABASE_URL="postgresql://waseetai_app:replace_with_a_long_password@postgres:5432/waseetai_db?schema=public"

JWT_SECRET="replace_with_64_plus_random_characters"
OTP_SECRET="replace_with_a_different_64_plus_random_characters"

# Auth rate limiting (login/register/OTP/forgot-password attempts per IP).
# Keep the safe production defaults below — do NOT raise these in production.
AUTH_RATE_LIMIT_WINDOW_MS=3600000
AUTH_RATE_LIMIT_MAX=10
FRONTEND_URL="https://app.example.com"
API_PUBLIC_URL="https://api.example.com"
CORS_ORIGINS="https://app.example.com"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace_with_a_random_password_of_at_least_12_characters"

# Gemini foundation only — not yet used by any live AI feature. Safe to leave unset.
GEMINI_API_KEY="replace_me"
CLOUDINARY_CLOUD_NAME="replace_me"
CLOUDINARY_API_KEY="replace_me"
CLOUDINARY_API_SECRET="replace_me"

SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@example.com"
SMTP_PASS="replace_me"
SMTP_FROM="noreply@example.com"
EMAIL_SENDER_NAME="Waseet AI"

# Login phone OTP — leave SMS_ENABLED unset/false until a real SMS gateway
# is wired up in notification.service.ts sendSmsOtp() (no provider implemented
# yet). While false, the OTP code is only logged server-side, never sent.
# SMS_ENABLED="false"
# SMS_PROVIDER="twilio"
# SMS_SENDER_ID="WaseetAI"

# PayPal (the only wallet deposit rail, USD). "sandbox" only is supported/tested
# so far; PAYPAL_CLIENT_SECRET/PAYPAL_WEBHOOK_ID must never reach the frontend.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="replace_me"
PAYPAL_CLIENT_SECRET="replace_me"
PAYPAL_WEBHOOK_ID="replace_me"
GOOGLE_CLIENT_ID="replace_me"
