# Copy to .env on the VPS and replace every placeholder.
NODE_ENV=production
PORT=5009
RUN_DB_MIGRATIONS=false
RUN_DB_PUSH=true
RUN_DB_PUSH_ACCEPT_DATA_LOSS=false
DB_HOST=postgres
DB_PORT=5432
VPS_API_PORT=5010
POSTGRES_DB=waseetai_db
POSTGRES_USER=waseetai_app
POSTGRES_PASSWORD="replace_with_a_long_random_password"

# Internal Docker network URL. Do not use localhost here.
DATABASE_URL="postgresql://waseetai_app:replace_with_a_long_password@postgres:5432/waseetai_db?schema=public"

JWT_SECRET="replace_with_64_plus_random_characters"
OTP_SECRET="replace_with_a_different_64_plus_random_characters"
FRONTEND_URL="https://app.example.com"
API_PUBLIC_URL="https://api.example.com"
CORS_ORIGINS="https://app.example.com"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace_with_a_random_password_of_at_least_12_characters"

OPENAI_API_KEY="replace_me"
CLOUDINARY_CLOUD_NAME="replace_me"
CLOUDINARY_API_KEY="replace_me"
CLOUDINARY_API_SECRET="replace_me"

SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@example.com"
SMTP_PASS="replace_me"
SMTP_FROM="noreply@example.com"
EMAIL_SENDER_NAME="Waseet AI"

MOYASAR_SECRET_KEY="replace_me"
MOYASAR_PUBLISHABLE_KEY="replace_me"
GOOGLE_CLIENT_ID="replace_me"
